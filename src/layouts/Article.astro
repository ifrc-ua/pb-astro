---
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
interface Props { title: string; description: string }
const { title, description } = Astro.props;

// Повні (абсолютні) адреси для тегів соцмереж. Facebook/LinkedIn/Telegram
// читають картинку зі свого сервера, тож шлях мусить бути з доменом.
// Astro.site береться з astro.config.mjs (https://pb.ifrc.org.ua).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-cover.png", Astro.site).href;

// Дата первинної публікації на КУРСі. Стала: dateModified свідомо не ставимо —
// дата, що змінюється з кожним деплоєм, читається пошуковиком як churn.
const PUBLISHED = "2026-07-11T12:41:14+03:00";
const KURS_ORIGINAL =
  "https://kurs.if.ua/article/desyat-vesen-ivano-frankivskogo-byudzhetu-uchasti/";

// Розмітка Schema.org для пошуку: тип NewsArticle, бо це журналістський
// матеріал. isBasedOn указує на первинну публікацію — так пошуковик бачить
// зв'язок замість двох незалежних копій того самого тексту.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: title,
  description,
  inLanguage: "uk-UA",
  datePublished: PUBLISHED,
  isBasedOn: KURS_ORIGINAL,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  url: canonical,
  image: [ogImage],
  author: {
    "@type": "Person",
    name: "Наталія Кобильчак",
    url: "https://www.linkedin.com/in/nataliia-kobylchak",
  },
  publisher: {
    "@type": "Organization",
    name: "Ivano-Frankivsk Regional Center, NGO",
    url: "https://ifrc.org.ua",
    logo: {
      "@type": "ImageObject",
      url: new URL("/apple-touch-icon.png", Astro.site).href,
      width: 180,
      height: 180,
    },
  },
  isAccessibleForFree: true,
  about: {
    "@type": "Thing",
    name: "Бюджет участі Івано-Франківської міської територіальної громади",
  },
};
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Наталія Кобильчак" />
  <link rel="canonical" href={canonical} />
  <!-- max-image-preview:large — дозволяє Google показувати велике прев'ю
       в результатах; для матеріалу з обкладинкою це помітна різниця в кліках -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta name="theme-color" content="#654EA3" />

  <!-- Дисплейна гарнітура заголовка — найімовірніший LCP-елемент сторінки,
       тож вантажимо її одразу, а не після розбору CSS. crossorigin
       обовʼязковий навіть для свого домену, інакше preload не зарахується. -->
  <link
    rel="preload"
    href="/fonts/Phenomena-Black.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <!-- Open Graph — картка-прев'ю у Facebook, LinkedIn, Telegram, Viber, Slack -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Бюджет участі Івано-Франківська" />
  <meta property="og:locale" content="uk_UA" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="2400" />
  <meta property="og:image:height" content="1260" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:image:type" content="image/png" />
  <meta property="article:published_time" content={PUBLISHED} />
  <meta property="article:author" content="Наталія Кобильчак" />

  <!-- Twitter/X — велика картинка -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Іконки в оптичній шкалі: у вкладці (16–48 px) одна жовта сота на фіолетовому
       полі, на «додати на головний екран» (180 px) — повна квітка з семи сот -->
  <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <script is:inline>
    if (localStorage.getItem("pb-theme") === "dark") document.documentElement.dataset.theme = "dark";
  </script>
</head>
<body>
  <header class="site-header"><ThemeToggle /></header>
  <main><slot /></main>
  <Footer />
</body>
</html>
