---
// Розкривний блок статті (нативний <details>, читабельний без JS).
// Стиль-референс — CLEANUP-LOG; оформлення токенами дизайн-системи.
// Жовті маркери-трикутники (заголовок і пункти списків) — завжди з ink-обводкою
// (design.md §7).
interface Props { summary: string; open?: boolean }
const { summary, open = false } = Astro.props;
---
<details class="pb-box" open={open}>
  <summary>{summary}</summary>
  <div class="pb-box__body"><slot /></div>
</details>

<style>
  .pb-box {
    max-width: 680px;
    margin: 1.8rem auto;
    padding: 4px 24px;
    /* Світла плашка в тон врізки-PullQuote: суцільний фіолетовий надто кидався
       в око для допоміжного блоку. --panel-2 на пів-ступеня темніше за поверхню
       секції, тож блок помітний, але не перетягує увагу. Surface перевизначає
       --panel-2 під кожен тон (на жовтій секції — #FFF6D0), тож плашка сама
       підлаштовується під лавандову й жовту поверхні та під нічну тему.
       Текстові токени локально НЕ фіксуємо — успадковуємо від поверхні. */
    background: var(--panel-2);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--brand) 25%, transparent);
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(26, 26, 26, 0.06);
  }
  .pb-box > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    font-family: "Phenomena", "Inter Variable", sans-serif;
    font-weight: 900;
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .pb-box > summary::-webkit-details-marker { display: none; }
  /* Трикутник-маркер: жовтий завжди з ink-обводкою #1A1A1A (design.md §7),
     повертається при відкритті.
     ОБВОДКА ТУТ НЕСУЧА, не декор. Відколи плашка світла, заливка #FFEC08 не дає
     контрасту з нею взагалі: 1,03:1 на лавандовій #EEEAF7, 1,12:1 на кремовій
     #FFF6D0. Форму маркера видно виключно завдяки ink-обводці (14,7:1 і 16:1).
     У нічній темі навпаки — заливка дає 12,7:1, а обводка майже зливається.
     Тобто прибрати filter не можна: на світлій темі маркери зникнуть. */
  .pb-box > summary::before {
    content: "";
    flex: none;
    width: 0; height: 0;
    border-style: solid;
    border-width: 7px 0 7px 11px;
    border-color: transparent transparent transparent var(--accent);
    /* ink-обводка акценту через тонкий drop-shadow по контуру трикутника */
    filter: drop-shadow(0.5px 0 0 #1a1a1a) drop-shadow(-0.5px 0 0 #1a1a1a)
            drop-shadow(0 0.5px 0 #1a1a1a) drop-shadow(0 -0.5px 0 #1a1a1a);
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pb-box[open] > summary::before { transform: rotate(90deg); }
  .pb-box__body {
    padding-bottom: 16px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink);
  }
  .pb-box__body :global(p) { margin-block: 0.8em; }
  .pb-box__body :global(p:first-child) { margin-top: 0; }
  /* Маркери списків — маленькі жовті трикутники, та сама форма й прийом, що в
     маркера-summary вище (CSS-трикутник + ink-обводка через drop-shadow, бо
     border на border-трикутнику не працює). design.md §7: жовте завжди з ink */
  .pb-box__body :global(ul) { margin-block: 0.8em; padding-left: 1.5em; list-style: none; }
  .pb-box__body :global(ul li) { margin-block: 0.35em; position: relative; }
  .pb-box__body :global(ul li)::before {
    content: "";
    position: absolute;
    left: -1.2em;
    top: 0.52em;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 4px 0 4px 7px; /* 8×7 — приблизно як були кружечки 9px */
    border-color: transparent transparent transparent var(--accent);
    filter: drop-shadow(0.5px 0 0 #1a1a1a) drop-shadow(-0.5px 0 0 #1a1a1a)
            drop-shadow(0 0.5px 0 #1a1a1a) drop-shadow(0 -0.5px 0 #1a1a1a);
  }
  /* Плашка тепер світла, тож фокус — брендовий фіолет (focus-ring дизайн-системи) */
  .pb-box > summary:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; border-radius: 4px; }
</style>
